{
  "name": "interview-os",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint apps/api apps/workers packages && pnpm --filter web lint",
    "format": "prettier --write",
    "format:check": "prettier --check .",
    "heroku-postbuild": "pnpm --filter @interview-os/config build && pnpm --filter @interview-os/database build && pnpm --filter @interview-os/redis build && pnpm --filter api build && echo '--- API build output ---' && ls -la apps/api/dist/src && test -f apps/api/dist/src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.9",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.9"
}
